# Line endings: keep LF in the repo
* text=auto eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.ico   binary
*.tgz   binary
*.zip   binary
*.wasm  binary
*.pdf   binary
*.docx  binary
*.gz    binary
*.traineddata binary

# Build output: not counted in GitHub's language bar
vanilla/index.js              linguist-generated=true
vanilla/index.min.js          linguist-generated=true
dist/**                       linguist-generated=true
src/grid/rust/gridCoreWasm.ts linguist-generated=true
src/agentic/rust/ragCoreWasm.ts linguist-generated=true

# Language bar: show the library itself (TypeScript, JavaScript, Rust)
# Vue and Python are early experiments that are not in the npm package yet
vue/**                            linguist-detectable=false
python/**                         linguist-detectable=false
# Examples and the CLI's app templates are sample code, not the library
examples/**                       linguist-documentation
packages/yuktai-cli/templates/**  linguist-documentation

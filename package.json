{
  "name": "@yuktishaalaa/yuktai",
  "version": "5.5.0",
  "description": "Accessibility, AI and data toolkit for Next.js, React and plain HTML: a 10 lakh row data grid with an AI assistant (voice, 24 languages, WebMCP), WCAG 2.2 auto-fix, QA reports, page Q&A and 163 icons, a loading screen, site language in English + 6 Indian languages and visitor-controlled animations. Runs in the browser: no API keys, no server, Rust (WebAssembly) engine.",
  "author": "Sandeep Miriyala — Yuktishaalaa AI Lab",
  "license": "GPL-3.0-only",
  "homepage": "https://yuktaidocs.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeep-miriyala/yuktai.git"
  },
  "bugs": {
    "url": "https://github.com/sandeep-miriyala/yuktai/issues"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "a11y",
    "aria",
    "react",
    "nextjs",
    "vanilla-js",
    "html",
    "no-framework",
    "browser-ai",
    "on-device-ai",
    "transformers",
    "rag",
    "gemini-nano",
    "agentic-ai",
    "data-grid",
    "webmcp",
    "telugu",
    "rust",
    "webassembly",
    "wasm",
    "indian-languages",
    "icons",
    "react-icons",
    "svg-icons",
    "ai-assistant",
    "grid-assistant",
    "voice",
    "speech-recognition",
    "hindi",
    "tamil",
    "indic",
    "pwa",
    "css-variables",
    "data-table",
    "large-dataset",
    "qa-audit",
    "wcag-2.2",
    "offline",
    "no-api-key",
    "loading-screen",
    "splash-screen",
    "animations",
    "i18n"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "icons": [
        "./dist/icons.d.ts"
      ],
      "experience": [
        "./dist/experience.d.ts"
      ],
      "head": [
        "./dist/head.d.ts"
      ]
    }
  },
  "unpkg": "vanilla/index.min.js",
  "jsdelivr": "vanilla/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.js"
    },
    "./experience": {
      "types": "./dist/experience.d.ts",
      "import": "./dist/experience.mjs",
      "require": "./dist/experience.js"
    },
    "./head": {
      "types": "./dist/head.d.ts",
      "import": "./dist/head.mjs",
      "require": "./dist/head.js"
    },
    "./vanilla": "./vanilla/index.min.js",
    "./vanilla/index.js": "./vanilla/index.js",
    "./vanilla/index.min.js": "./vanilla/index.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vanilla/index.js",
    "vanilla/index.min.js",
    "vanilla/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json && node scripts/type-entries.mjs",
    "build:vanilla": "node vanilla/build.mjs",
    "build:all": "npm run build && npm run build:vanilla",
    "build:rust": "node rust/build-wasm.mjs",
    "test:rust": "cd rust/grid-core && cargo test && cd ../rag-core && cargo test && cd ../ask-core && cargo test",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build:all"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "browserslist": [
    "Chrome >= 113",
    "Edge >= 113"
  ]
}

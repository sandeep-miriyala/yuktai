{
  "manifest_version": 3,
  "name": "Ask this page",
  "version": "0.1.2",
  "description": "Ask any web page a question. Answers come from the page itself, with the source highlighted. Runs on your device; nothing is sent anywhere.",
  "homepage_url": "https://github.com/sandeep-miriyala/yuktai/tree/main/packages/ask-page",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Ask this page (Alt+Shift+A)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Open or close Ask this page" }
  }
}

{
  "name": "@yuktishaalaa/a11y",
  "version": "6.0.3",
  "description": "YuktAI engine (accessibility): safe ARIA, WCAG AA/AAA contrast, automatic lang for every part, read aloud in the right voice, smart dark mode and visitor preferences for any page. One attribute, no server.",
  "author": "Sandeep Miriyala — Yuktishaalaa AI Lab",
  "license": "GPL-3.0-only",
  "homepage": "https://sandeep-miriyala.github.io/yuktai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeep-miriyala/yuktai.git",
    "directory": "packages/a11y"
  },
  "bugs": {
    "url": "https://github.com/sandeep-miriyala/yuktai/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "aria",
    "contrast",
    "lang",
    "text-to-speech",
    "web-speech",
    "telugu",
    "indic",
    "screen-reader"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/a11y.global.js",
  "jsdelivr": "./dist/a11y.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/a11y.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/a11y.global.js"
  ],
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "manifest_version": 3,
  "name": "YuktAI Assistant",
  "version": "6.0.0",
  "description": "Accessibility for any website (colours, dark mode, text size, read aloud in the right voice, safe fixes) and Ask this page. Runs on your device; nothing is sent anywhere.",
  "homepage_url": "https://github.com/sandeep-miriyala/yuktai/tree/main/packages/assistant",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "YuktAI Assistant (Alt+Shift+Y)",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Y" }, "description": "Open YuktAI Assistant" },
    "ask-page": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Ask this page" }
  }
}
